{
  "name": "ride-the-races-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "doctor": "npx expo-doctor",
    "eas:init": "npx eas-cli@latest init",
    "eas:configure-updates": "npx eas-cli@latest update:configure",
    "eas:build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "eas:build:ios:production": "npx eas-cli@latest build --platform ios --profile production",
    "eas:update:preview": "npx eas-cli@latest update --channel preview",
    "eas:update:production": "npx eas-cli@latest update --channel production"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo-location": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-task-manager": "~57.0.20",
    "react-native-svg": "~15.15.1",
    "expo-image-picker": "~57.0.20",
    "expo-speech": "~57.0.3",
    "expo-updates": "~57.0.23"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
